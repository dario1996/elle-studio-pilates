<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

<!-- CREA TABELLA UTENTI -->

    <changeSet id="001-01" author="vincenzo">
        <comment>Crea tabella utenti</comment>

        <createTable tableName="utenti">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="username" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="VARCHAR(150)">
                <constraints nullable="true" unique="true" />
            </column>
            <column name="nome" type="VARCHAR(100)">
                <constraints nullable="true" />
            </column>
            <column name="cognome" type="VARCHAR(100)">
                <constraints nullable="true" />
            </column>
            <column name="codice_fiscale" type="VARCHAR(16)">
                <constraints nullable="true" unique="true" />
            </column>
            <column name="certificato_medico" type="VARCHAR(500)">
                <constraints nullable="true" />
            </column>
            <column name="patologie" type="BOOLEAN">
                <constraints nullable="true" />
            </column>
            <column name="descrizione_patologie" type="TEXT">
                <constraints nullable="true" />
            </column>
            <column name="obiettivi" type="TEXT">
                <constraints nullable="true" />
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="attivo" type="VARCHAR(10)" defaultValue="Si">
                <constraints nullable="false" />
            </column>
            <column name="gruppo" type="VARCHAR(250)">
                <constraints nullable="true" />
            </column>
            <column name="ruoli" type="VARCHAR(500)">
                <constraints nullable="true" />
            </column>
            <column name="data_creazione" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="data_modifica" type="TIMESTAMP">
                <constraints nullable="true" />
            </column>
        </createTable>
    </changeSet>

<!-- CREA TABELLA CORSI -->

    <changeSet id="001-02" author="vincenzo">
        <comment>Crea tabella corsi</comment>

        <createTable tableName="corsi">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="nome" type="VARCHAR(200)">
                <constraints nullable="false" />
            </column>
            <column name="categoria" type="VARCHAR(100)">
                <constraints nullable="true" />
            </column>
            <column name="descrizione" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="livello" type="VARCHAR(50)" defaultValue="PRINCIPIANTE">
                <constraints nullable="false"/>
            </column>
            <column name="durata_minuti" type="INTEGER">
                <constraints nullable="true"/>
            </column>
            <column name="max_partecipanti" type="INTEGER">
                <constraints nullable="true"/>
            </column>
            <column name="prezzo" type="DECIMAL(10,2)">
                <constraints nullable="true"/>
            </column>
            <column name="stato" type="VARCHAR(20)" defaultValue="PIANIFICATO">
                <constraints nullable="false" />
            </column>
            <column name="attivo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="data_creazione" type="TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="data_modifica" type="TIMESTAMP">
                <constraints nullable="true" />
            </column>
        </createTable>
    </changeSet>

<!-- CREA TABELLA LEZIONI -->

    <changeSet id="001-03" author="vincenzo">
        <comment>Crea tabella lezioni</comment>
        <createTable tableName="lezioni">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="titolo" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="data_inizio" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="data_fine" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="istruttore" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="tipo_lezione" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="TEXT"/>
            <column name="attiva" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

<!-- CREA TABELLA LEZIONE_PARTECIPANTI -->

    <changeSet id="001-04" author="vincenzo">
        <comment>Crea tabella per i partecipanti alle lezioni</comment>

        <createTable tableName="lezione_partecipanti">
            <column name="lezione_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="partecipanti_username" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

<!-- CREA TABELLA VENDITE -->

    <changeSet id="001-05" author="vincenzo">
        <comment>Crea tabella vendite per gestire acquisti corsi</comment>

        <createTable tableName="vendite">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="utente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="corso_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="importo" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="stato" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="data_acquisto" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="data_pagamento" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
            <column name="note" type="TEXT">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

<!-- CREA TABELLA LEARNING_DATA -->

    <changeSet id="001-06" author="vincenzo">
        <comment>Crea tabella per memorizzare i dati di apprendimento importati da file JSON</comment>

        <createTable tableName="learning_data">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="first_name" type="VARCHAR(100)">
                <constraints nullable="true" />
            </column>
            <column name="last_name" type="VARCHAR(100)">
                <constraints nullable="true" />
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="content_name" type="VARCHAR(500)">
                <constraints nullable="false" />
            </column>
            <column name="content_type" type="VARCHAR(100)">
                <constraints nullable="true" />
            </column>
            <column name="time_viewed_seconds" type="BIGINT">
                <constraints nullable="true" />
            </column>
            <column name="percentage_complete" type="DECIMAL(5,2)">
                <constraints nullable="true" />
            </column>
            <column name="completion_date" type="DATE">
                <constraints nullable="true" />
            </column>
            <column name="skills" type="TEXT">
                <constraints nullable="true" />
            </column>
            <column name="rating" type="DECIMAL(3,2)">
                <constraints nullable="true" />
            </column>
            <column name="total_ratings" type="INT">
                <constraints nullable="true" />
            </column>
            <column name="difficulty" type="VARCHAR(50)">
                <constraints nullable="true" />
            </column>
            <column name="course_url" type="TEXT">
                <constraints nullable="true" />
            </column>
            <column name="employee_id" type="VARCHAR(50)">
                <constraints nullable="true" />
            </column>
            <column name="content_id" type="VARCHAR(50)">
                <constraints nullable="true" />
            </column>
            <column name="provider" type="VARCHAR(100)">
                <constraints nullable="true" />
            </column>
            <column name="processed" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false" />
            </column>
            <column name="processed_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="source_file" type="VARCHAR(255)">
                <constraints nullable="true" />
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP"
                defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>


<!-- CREA TABELLA GRUPPI -->
    <changeSet id="001-07" author="vincenzo">
        <comment>Crea tabella gruppi</comment>
        
        <createTable tableName="gruppi">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nome" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="descrizione" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
            <column name="colore" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
            <column name="attivo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="data_creazione" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="data_modifica" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>


    <!-- CREA TABELLA ASSOCIATIVA UTENTI_GRUPPI -->
    <changeSet id="001-08" author="vincenzo">
        <comment>Crea tabella associativa per relazione many-to-many tra utenti e gruppi</comment>
        
        <createTable tableName="utenti_gruppi">
            <column name="utente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="gruppo_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="data_assegnazione" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <!-- Primary key composita -->
        <addPrimaryKey tableName="utenti_gruppi" 
                       columnNames="utente_id, gruppo_id" 
                       constraintName="pk_utenti_gruppi"/>
        
        <!-- Foreign keys -->
        <addForeignKeyConstraint baseTableName="utenti_gruppi"
                                 baseColumnNames="utente_id"
                                 constraintName="fk_utenti_gruppi_utente"
                                 referencedTableName="utenti"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        
        <addForeignKeyConstraint baseTableName="utenti_gruppi"
                                 baseColumnNames="gruppo_id"
                                 constraintName="fk_utenti_gruppi_gruppo"
                                 referencedTableName="gruppi"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

<!-- CREA TABELLA PROCESSING_LOG -->

    <changeSet id="001-09" author="vincenzo">
        <comment>Crea tabella per tracciare lo stato di elaborazione dei file JSON</comment>

        <createTable tableName="processing_log">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>

            <column name="file_name" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="file_path" type="VARCHAR(500)">
                <constraints nullable="false" />
            </column>
            <column name="file_size" type="BIGINT">
                <constraints nullable="true" />
            </column>
            <column name="processing_status" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
            <column name="records_processed" type="INT" defaultValue="0">
                <constraints nullable="false" />
            </column>
            <column name="records_failed" type="INT" defaultValue="0">
                <constraints nullable="false" />
            </column>
            <column name="error_message" type="TEXT">
                <constraints nullable="true" />
            </column>
            <column name="started_at" type="TIMESTAMP">
                <constraints nullable="true" />
            </column>
            <column name="completed_at" type="TIMESTAMP">
                <constraints nullable="true" />
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP"
                defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>