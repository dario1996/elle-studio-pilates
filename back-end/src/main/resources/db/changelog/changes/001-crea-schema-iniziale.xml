<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

<!-- CREA TABELLA UTENTI -->

    <changeSet id="001-01" author="vincenzo">
        <comment>Crea tabella utenti</comment>

        <createTable tableName="utenti">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="username" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="VARCHAR(150)">
                <constraints nullable="true" unique="true" />
            </column>
            <column name="nome" type="VARCHAR(100)">
                <constraints nullable="true" />
            </column>
            <column name="cognome" type="VARCHAR(100)">
                <constraints nullable="true" />
            </column>
            <column name="codice_fiscale" type="VARCHAR(16)">
                <constraints nullable="true" unique="true" />
            </column>
            <column name="indirizzo" type="VARCHAR(200)">
                <constraints nullable="false" />
            </column>
            <column name="città" type="VARCHAR(100)">
                <constraints nullable="false" />
            </column>
            <column name="telefono" type="VARCHAR(20)">
                <constraints nullable="true" />
            </column>
            <column name="certificato_medico_file" type="LONGBLOB">
                <constraints nullable="true"/>
            </column>
            <column name="certificato_medico_nome" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="certificato_medico_data_upload" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
            <column name="patologie" type="BOOLEAN">
                <constraints nullable="true" />
            </column>
            <column name="descrizione_patologie" type="TEXT">
                <constraints nullable="true" />
            </column>
            <column name="obiettivi" type="TEXT">
                <constraints nullable="true" />
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="attivo" type="VARCHAR(10)" defaultValue="Si">
                <constraints nullable="false" />
            </column>
            <column name="ruoli" type="VARCHAR(500)">
                <constraints nullable="true" />
            </column>
            <column name="data_creazione" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="data_modifica" type="TIMESTAMP">
                <constraints nullable="true" />
            </column>
        </createTable>
    </changeSet>

<!-- CREA TABELLA PACCHETTI -->

    <changeSet id="001-02" author="vincenzo">
        <comment>Crea tabella pacchetti</comment>
    
        <createTable tableName="pacchetti">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="nome" type="VARCHAR(200)">
                <constraints nullable="false" />
            </column>
            <column name="categoria" type="VARCHAR(100)">
                <constraints nullable="true" />
            </column>
            <column name="descrizione" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="livello" type="VARCHAR(50)" defaultValue="PRINCIPIANTE">
                <constraints nullable="false"/>
            </column>
            <column name="durata_minuti" type="INTEGER">
                <constraints nullable="true"/>
            </column>
            <column name="max_partecipanti" type="INTEGER">
                <constraints nullable="true"/>
            </column>
            <column name="prezzo" type="DECIMAL(10,2)">
                <constraints nullable="true"/>
            </column>
            <column name="stato" type="VARCHAR(20)" defaultValue="PIANIFICATO">
                <constraints nullable="false" />
            </column>
            <column name="attivo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="data_creazione" type="TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="data_modifica" type="TIMESTAMP">
                <constraints nullable="true" />
            </column>
        </createTable>
    </changeSet>

<!-- CREA TABELLA LEZIONI -->

    <changeSet id="001-03" author="vincenzo">
        <comment>Crea tabella lezioni</comment>
        <createTable tableName="lezioni">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="titolo" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="data_inizio" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="data_fine" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="istruttore" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="tipo_lezione" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="TEXT"/>
            <column name="attiva" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="template_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="pacchetto_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="max_partecipanti" type="INTEGER" defaultValue="1">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

<!-- CREA TABELLA CALENDARIO_SETTIMANALE -->

    <changeSet id="001-04" author="vincenzo">
        <comment>Crea tabella calendario_settimanale per definire il template ricorrente delle lezioni</comment>
        
        <createTable tableName="calendario_settimanale">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="giorno_settimana" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="ora_inizio" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="ora_fine" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="titolo" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="tipo_lezione" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="istruttore" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="max_partecipanti" type="INTEGER" defaultValue="1">
                <constraints nullable="false"/>
            </column>
            <column name="colore" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
            <column name="note" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="attivo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

<!-- CREA TABELLA VENDITE -->

    <changeSet id="001-06" author="vincenzo">
        <comment>Crea tabella vendite per gestire acquisti pacchetti</comment>

        <createTable tableName="vendite">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="utente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="pacchetto_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="importo" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="stato" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="data_acquisto" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="data_pagamento" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
            <column name="note" type="TEXT">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

<!-- CREA TABELLA PROCESSING_LOG -->

    <changeSet id="001-07" author="vincenzo">
        <comment>Crea tabella per tracciare lo stato di elaborazione dei file JSON</comment>

        <createTable tableName="processing_log">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>

            <column name="file_name" type="VARCHAR(255)">
                <constraints nullable="false" />
            </column>
            <column name="file_path" type="VARCHAR(500)">
                <constraints nullable="false" />
            </column>
            <column name="file_size" type="BIGINT">
                <constraints nullable="true" />
            </column>
            <column name="processing_status" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
            <column name="records_processed" type="INT" defaultValue="0">
                <constraints nullable="false" />
            </column>
            <column name="records_failed" type="INT" defaultValue="0">
                <constraints nullable="false" />
            </column>
            <column name="error_message" type="TEXT">
                <constraints nullable="true" />
            </column>
            <column name="started_at" type="TIMESTAMP">
                <constraints nullable="true" />
            </column>
            <column name="completed_at" type="TIMESTAMP">
                <constraints nullable="true" />
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP"
                defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="001-08" author="vincenzo">
        <comment>Crea tabella di join per la relazione molti a molti tra lezioni e utenti (partecipanti lezioni)</comment>
        <createTable tableName="lezione_partecipanti">
            <column name="lezione_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="utente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="data_lezione" type="DATE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="lezione_partecipanti" columnNames="lezione_id,utente_id" constraintName="PK_lezione_partecipanti"/>
    </changeSet>

    <changeSet id="001-09" author="vincenzo">
        <comment>Crea tabella di join per pacchetti disponibili per utente</comment>
        <createTable tableName="utente_pacchetti_disponibili">
            <column name="utente_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pacchetto_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="data_assegnazione" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    
    <changeSet id="001-10" author="vincenzo">
        <createTable tableName="password_reset_tokens">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="token" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="utente_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="data_creazione" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="data_scadenza" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="utilizzato" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>