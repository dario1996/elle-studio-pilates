<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <!-- DROP ALL TABLES IF EXIST -->
    <changeSet id="000-01" author="vincenzo" runAlways="true">
        <comment>Drop all tables before recreating schema (dev only)</comment>

        <preConditions onFail="MARK_RAN">
            <tableExists tableName="vendite"/>
        </preConditions>
        <dropTable tableName="vendite" cascadeConstraints="true"/>

        <preConditions onFail="MARK_RAN">
            <tableExists tableName="lezioni"/>
        </preConditions>
        <dropTable tableName="lezioni" cascadeConstraints="true"/>

        <preConditions onFail="MARK_RAN">
            <tableExists tableName="pacchetti"/>
        </preConditions>
        <dropTable tableName="pacchetti" cascadeConstraints="true"/>

        <preConditions onFail="MARK_RAN">
            <tableExists tableName="utenti"/>
        </preConditions>
        <dropTable tableName="utenti" cascadeConstraints="true"/>

        <preConditions onFail="MARK_RAN">
            <tableExists tableName="lezione_partecipanti"/>
        </preConditions>
        <dropTable tableName="lezione_partecipanti" cascadeConstraints="true"/>
    </changeSet>

</databaseChangeLog>