<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

<changeSet id="002-01" author="vincenzo">
        <comment>Create foreign key constraints</comment>

        <addForeignKeyConstraint 
            baseTableName="vendite" 
            baseColumnNames="utente_id"
            constraintName="fk_vendite_utente"
            referencedTableName="utenti"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <addForeignKeyConstraint 
            baseTableName="vendite" 
            baseColumnNames="pacchetto_id"
            constraintName="fk_vendite_pacchetto"
            referencedTableName="pacchetti"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

        <addForeignKeyConstraint 
            baseTableName="prenotazioni_lezioni"
            baseColumnNames="lezione_id"
            constraintName="fk_prenotazioni_lezioni_lezioni"
            referencedTableName="lezioni"
            referencedColumnNames="id"
            onDelete="CASCADE"/>
        
        <addForeignKeyConstraint 
            baseTableName="prenotazioni_lezioni"
            baseColumnNames="partecipanti_username"
            constraintName="fk_prenotazioni_lezioni_utenti"
            referencedTableName="utenti"
            referencedColumnNames="username"
            onDelete="CASCADE"/>

        <addForeignKeyConstraint 
            baseTableName="lezioni"
            baseColumnNames="template_id"
            constraintName="fk_lezioni_calendario_template"
            referencedTableName="calendario_settimanale"
            referencedColumnNames="id"
            onDelete="SET NULL"/>

    </changeSet>

</databaseChangeLog> 