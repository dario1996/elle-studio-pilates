<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="003-01" author="sistema-formazione">
        <comment>Create indexes for better performance</comment>

<!-- Indici per la tabella utenti -->

        <createIndex tableName="utenti" indexName="idx_utenti_email">
            <column name="email" />
        </createIndex>

        <createIndex tableName="utenti" indexName="idx_utenti_attivo">
            <column name="attivo" />
        </createIndex>

        <createIndex tableName="utenti" indexName="idx_utenti_codice_fiscale">
            <column name="codice_fiscale" />
        </createIndex>

<!-- Indici per la tabella pacchetti -->

        <createIndex indexName="idx_pacchetto_stato" tableName="pacchetti">
            <column name="stato" />
        </createIndex>

        <createIndex indexName="idx_pacchetto_categoria" tableName="pacchetti">
            <column name="categoria" />
        </createIndex>

<!-- Indici per la tabella lezioni -->

        <createIndex tableName="lezioni" indexName="idx_lezioni_data_inizio">
            <column name="data_inizio"/>
        </createIndex>
        
        <createIndex tableName="lezioni" indexName="idx_lezioni_istruttore">
            <column name="istruttore"/>
        </createIndex>
        
        <createIndex tableName="lezioni" indexName="idx_lezioni_tipo_lezione">
            <column name="tipo_lezione"/>
        </createIndex>
        
        <createIndex tableName="lezioni" indexName="idx_lezioni_attiva">
            <column name="attiva"/>
        </createIndex>
        
        <createIndex tableName="lezioni" indexName="idx_lezioni_range_date">
            <column name="data_inizio"/>
            <column name="data_fine"/>
        </createIndex>

        <createIndex tableName="lezioni" indexName="idx_lezioni_template">
            <column name="template_id"/>
        </createIndex>

<!-- Indici per la tabella prenotazioni_lezioni -->

        <createIndex tableName="prenotazioni_lezioni" indexName="idx_prenotazioni_lezioni_lezione">
            <column name="lezione_id"/>
        </createIndex>
        
        <createIndex tableName="prenotazioni_lezioni" indexName="idx_prenotazioni_lezioni_utenti">
            <column name="partecipanti_username"/>
        </createIndex>

<!-- Indici per la tabella vendite -->

        <createIndex tableName="vendite" indexName="idx_vendite_utente">
            <column name="utente_id"/>
        </createIndex>

        <createIndex tableName="vendite" indexName="idx_vendite_pacchetto">
            <column name="pacchetto_id"/>
        </createIndex>

        <createIndex tableName="vendite" indexName="idx_vendite_stato">
            <column name="stato"/>
        </createIndex>

        <createIndex tableName="vendite" indexName="idx_vendite_data_acquisto">
            <column name="data_acquisto"/>
        </createIndex>

        <createIndex tableName="vendite" indexName="idx_vendite_data_pagamento">
            <column name="data_pagamento"/>
        </createIndex>
    
<!-- Indici per la tabella PROCESSING_LOG -->

        <createIndex tableName="processing_log" indexName="idx_processing_log_file_name">
            <column name="file_name" />
        </createIndex>

        <createIndex tableName="processing_log" indexName="idx_processing_log_status">
            <column name="processing_status" />
        </createIndex>

        <createIndex tableName="processing_log" indexName="idx_processing_log_created_at">
            <column name="created_at" />
        </createIndex>        

<!-- Indici per la tabella calendario_settimanale -->

        <createIndex tableName="calendario_settimanale" indexName="idx_calendario_giorno">
            <column name="giorno_settimana"/>
        </createIndex>
        
        <createIndex tableName="calendario_settimanale" indexName="idx_calendario_ora_inizio">
            <column name="ora_inizio"/>
        </createIndex>
        
        <createIndex tableName="calendario_settimanale" indexName="idx_calendario_tipo">
            <column name="tipo_lezione"/>
        </createIndex>
        
        <createIndex tableName="calendario_settimanale" indexName="idx_calendario_attivo">
            <column name="attivo"/>
        </createIndex>

    </changeSet>

</databaseChangeLog> 