<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="022-create-lezione-partecipanti-table" author="system">
        <comment>Create join table for lesson participants</comment>
        
        <!-- Drop existing table if it exists with wrong structure -->
        <dropTable tableName="lezione_partecipanti" cascadeConstraints="true"/>
        
        <createTable tableName="lezione_partecipanti">
            <column name="lezione_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="partecipanti_username" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <!-- Add foreign key constraints -->
        <addForeignKeyConstraint baseTableName="lezione_partecipanti"
                                baseColumnNames="lezione_id"
                                constraintName="fk_lezione_partecipanti_lezione"
                                referencedTableName="lezioni"
                                referencedColumnNames="id"
                                onDelete="CASCADE"/>
        
        <addForeignKeyConstraint baseTableName="lezione_partecipanti"
                                baseColumnNames="partecipanti_username"
                                constraintName="fk_lezione_partecipanti_utenti"
                                referencedTableName="utenti"
                                referencedColumnNames="username"
                                onDelete="CASCADE"/>
        
        <!-- Add primary key constraint -->
        <addPrimaryKey tableName="lezione_partecipanti" 
                      columnNames="lezione_id,partecipanti_username" 
                      constraintName="pk_lezione_partecipanti"/>
        
        <!-- Add indexes for better performance -->
        <createIndex tableName="lezione_partecipanti" indexName="idx_lezione_partecipanti_lezione">
            <column name="lezione_id"/>
        </createIndex>
        
        <createIndex tableName="lezione_partecipanti" indexName="idx_lezione_partecipanti_utenti">
            <column name="partecipanti_username"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
