<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="013-01" author="auto">
        <comment>Creazione tabella di mapping pacchetto -> calendario_settimana (many-to-many)</comment>
        <createTable tableName="pacchetto_calendario">
            <column name="pacchetto_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="calendario_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="pacchetto_calendario" columnNames="pacchetto_id,calendario_id" constraintName="pk_pacchetto_calendario"/>

        <addForeignKeyConstraint baseTableName="pacchetto_calendario" baseColumnNames="pacchetto_id"
                                 referencedTableName="pacchetti" referencedColumnNames="id"
                                 constraintName="fk_pacchetto_calendario_pacchetto"/>

        <addForeignKeyConstraint baseTableName="pacchetto_calendario" baseColumnNames="calendario_id"
                                 referencedTableName="calendario_settimanale" referencedColumnNames="id"
                                 constraintName="fk_pacchetto_calendario_calendario"/>
    </changeSet>

</databaseChangeLog>
